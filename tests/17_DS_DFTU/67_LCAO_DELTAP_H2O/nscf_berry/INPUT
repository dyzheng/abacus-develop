INPUT_PARAMETERS
suffix      H2O
calculation nscf
basis_type  lcao
ecutwfc     100
gamma_only  0

nspin       1
scf_thr     1.0e-8
scf_nmax    100
out_chg     0
smearing_method gauss
smearing_sigma  0.01
mixing_type     broyden
mixing_beta     0.4
ks_solver       genelpa
symmetry        0

init_chg    file
read_file_dir ../scf/OUT.H2O

berry_phase 1
gdir        3

deltap_switch       1
deltap_method       wannier
deltap_rm           3.0
deltap_gdir         3
deltap_gauge_mode   smo_anchored

pseudo_dir  /root/pporb/apns-pseudopotentials-v1
orbital_dir /root/pporb/apns-orbitals-efficiency-v1
