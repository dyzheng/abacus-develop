INPUT_PARAMETERS
suffix      H2O
calculation nscf
basis_type  lcao
ecutwfc     100
gamma_only  0

nspin       1
nbands      4
scf_thr     1.0e-8
scf_nmax    100
out_chg     0
smearing_method fixed
smearing_sigma  0.01
mixing_type     broyden
mixing_beta     0.4
ks_solver       genelpa
symmetry        0

init_chg    file
read_file_dir ../scf/OUT.H2O

towannier90       1
nnkpfile          h2o.nnkp
wannier_method    2
wannier_spin      up
out_wannier_mmn   1
out_wannier_amn   1
out_wannier_eig   1
out_wannier_unk   0

pseudo_dir  /root/pporb/apns-pseudopotentials-v1
orbital_dir /root/pporb/apns-orbitals-efficiency-v1
