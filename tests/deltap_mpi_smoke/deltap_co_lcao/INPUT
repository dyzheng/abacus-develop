INPUT_PARAMETERS
suffix    co
calculation    scf
basis_type    lcao
ecutwfc    100
ecutrho    400
gamma_only    0
nspin    1
scf_thr    1.0e-8
scf_nmax    100
out_chg    0
smearing_method    gauss
smearing_sigma    0.002
mixing_type    broyden
mixing_beta    0.4
ks_solver    genelpa
symmetry    0
nbands    15
berry_phase    1

# DeltaP settings - odd NBANDS (15) not divisible by the 2-col process grid:
# regression guard for the D_I Allreduce truncation / band-mixing bug (A' fix).
deltap_switch    1
deltap_method    wannier
deltap_corr      1
deltap_inner_nmax      0
deltap_lambda_init  0.0
deltap_lambda_step  0.01
deltap_lambda_mixing  0.1
deltap_inner_thr  1.0e-3
deltap_rm        3.0
deltap_gdir      3
deltap_target_file  target.dat
cal_force        1

pseudo_dir    /root/pporb/apns-pseudopotentials-v1
orbital_dir    /root/pporb/apns-orbitals-efficiency-v1
