INPUT_PARAMETERS
suffix                autotest
calculation           scf
basis_type            lcao
gamma_only            0
nspin                 1
nbands                40
ecutwfc               60
ecutrho               240
scf_thr               1e-8
scf_nmax              800
smearing_method       gaussian
smearing_sigma        0.002
mixing_type           broyden
mixing_beta           0.7
ks_solver             genelpa
symmetry              0
pseudo_dir            /root/abacus-develop/tests/PP_ORB
orbital_dir           /root/abacus-develop/tests/PP_ORB
constraint            true
constraint_type       charge
constraint_weight_type becke
constraint_target_file constraint_target.json
constraint_target_mode delta
constraint_mu_max     5.0
constraint_thr        1e-4
init_chg              file
read_file_dir         /tmp/mgo_prod/S2_ref/OUT.autotest
